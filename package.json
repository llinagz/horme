{
  "name": "horme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "tsc --noEmit --incremental false && next build --webpack",
    "preview": "serve out -l 3000",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node --require ./scripts/use-typescript6.cjs ./node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@serwist/next": "9.5.12",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-is": "19.2.8",
    "recharts": "3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/typescript6": "6.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "prettier": "3.6.2",
    "serve": "14.2.6",
    "serwist": "9.5.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
